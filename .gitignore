# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example is committed, real values never are
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test evidence and reports (regenerate with `npm run test:e2e` / `npm run shots`)
/artifacts/playwright-report
/artifacts/playwright-results

# video intermediates (regenerate with `npm run video`); the finished MP4 is kept
/artifacts/video/raw
/artifacts/video/work
/artifacts/video/captions
/artifacts/video/screen.webm
/artifacts/video/narration.wav
