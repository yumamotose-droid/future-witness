{
  "name": "future-witness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docs:sources": "tsx scripts/generate-data-sources.ts",
    "shots": "tsx scripts/capture-screenshots.mts",
    "clean": "rm -rf .next tsconfig.tsbuildinfo && find . -name '* [0-9].*' -not -path './node_modules/*' -delete",
    "predeploy": "tsx scripts/predeploy-check.mts",
    "verify:sources": "tsx scripts/verify-sources.mts",
    "validate": "tsx scripts/validate-negative.mts && tsx scripts/validate-runs.mts",
    "validate:live": "tsx scripts/validate-runs.mts --live --realtime",
    "video:narration": "tsx scripts/make-narration.mts",
    "video:record": "tsx scripts/record-demo.mts",
    "video:captions": "tsx scripts/render-captions.mts",
    "video:build": "tsx scripts/build-video.mts",
    "video": "npm run video:narration && npm run video:record && npm run video:captions && npm run video:build",
    "audit:viewports": "tsx scripts/audit-viewports.mts",
    "docs:demo": "tsx scripts/generate-demo-script.mts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
