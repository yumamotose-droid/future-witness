# FUTURE WITNESS — server environment
#
# Copy to .env.local for local development. Never commit .env.local.
# Every value here is read on the SERVER ONLY. No key is exposed to the browser:
# there is no NEXT_PUBLIC_ variable in this project, and that is deliberate.

# ---------------------------------------------------------------------------
# Generative model (optional)
# ---------------------------------------------------------------------------
# Without this key the app runs in scripted mode: the hand-written deliberation
# plus real sources retrieved from the corpus. The UI labels every such run
# 事前生成 / pre-written and the audit panel reports that no model was called.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override the model id. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Durable history (optional, off by default)
# ---------------------------------------------------------------------------
# Leave these empty to keep history in the browser only, which is the default
# and the privacy-preserving choice. See SECURITY.md before enabling.
# Apply supabase/schema.sql first; it enables RLS and creates no policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Testing only — must NOT be set in production
# ---------------------------------------------------------------------------
# Raises the per-address rate limit so an end-to-end run can perform many
# deliberations in a few minutes. /api/health reports when this is in effect.
RATE_LIMIT_CAPACITY=
